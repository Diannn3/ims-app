# Public Supabase connection values used by SvelteKit SSR.
# The publishable key is intentionally browser-safe when RLS/grants are configured.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy projects may still expose an anon key. The runtime accepts
# PUBLIC_SUPABASE_ANON_KEY as a fallback, but new deployments should prefer the
# publishable key above.
# PUBLIC_SUPABASE_ANON_KEY=your-anon-key
