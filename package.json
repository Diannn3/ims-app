{
  "name": "ims-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "generate:maps": "node scripts/generate-svgs.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "verify:project": "node scripts/verify-project.mjs",
    "verify": "npm run verify:data && npm run verify:project",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "types:db": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test": "npm run test:unit && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.9",
    "csv-parse": "^7.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.70.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@testing-library/svelte": "^5.2.0",
    "svelte": "^5.56.0",
    "svelte-check": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
